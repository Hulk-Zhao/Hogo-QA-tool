{
  "name": "hogo-qa-tool",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "离线质量过程能力分析工具：SPC 控制图 / Cp·Cpk·Pp·Ppk / 柏拉图 / 判异准则（西方电气规则），支持一键日报导出与可选 AI 解读",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --config vite.config.offline.ts",
    "build:server": "tsc -b && vite build",
    "preview": "vite preview --outDir dist-server",
    "serve": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "verify": "npm run typecheck && npm run lint && npm test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,js,cjs,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^5.16.7",
    "@mui/material": "^5.16.7",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^30.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "keywords": [
    "spc",
    "cpk",
    "ppk",
    "quality",
    "quality-management",
    "control-chart",
    "pareto",
    "manufacturing",
    "offline-first",
    "react",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/Hulk-Zhao/Hogo-QA-tool#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hulk-Zhao/Hogo-QA-tool.git"
  },
  "bugs": {
    "url": "https://github.com/Hulk-Zhao/Hogo-QA-tool/issues"
  }
}
